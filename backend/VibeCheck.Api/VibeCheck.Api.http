@VibeCheck.Api_HostAddress = https://localhost:7226

# Kollar att api:et svarar. Ska ge tillbaka JSON som beskriver
# vilka endpoints som finns. Tomt innehåll är ok så länge vi inte
# har några controllers än, huvudsaken är att vi får 200 och inte
# ett anslutningsfel.
GET {{VibeCheck.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Dagens ord. Ska ge samma svar hur många gånger du än kör den idag,
# och ett annat ord imorgon.
GET {{VibeCheck.Api_HostAddress}}/api/words/word-of-the-day
Accept: application/json


###

# Kör den här FÖRST. Kopiera "token" ur svaret och klistra in nedan.
POST {{VibeCheck.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "user",
  "password": "User123!"
}

###

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..AHZnUPDqXlL9PmmrioRPW9kFuYu-tc3ckPx1AIVUh7I

# Listan med alla tre quiz.
GET {{VibeCheck.Api_HostAddress}}/api/quiz
Authorization: Bearer {{token}}

###

# Advanced (quizId 3) ska vara LÅST – 400 med förklarande meddelande.
POST {{VibeCheck.Api_HostAddress}}/api/quiz/3/attempts
Authorization: Bearer {{token}}

###

# Basics (quizId 1) ska gå att starta.
# Kopiera quizAttemptId ur svaret och klistra in nedan.
POST {{VibeCheck.Api_HostAddress}}/api/quiz/1/attempts
Authorization: Bearer {{token}}

###

@attemptId = 3

# Svara på en fråga. Byt questionId/alternativeId mot värden
# ur frågelistan du fick när quizet startades.
POST {{VibeCheck.Api_HostAddress}}/api/quiz/attempts/{{attemptId}}/answers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "questionId": 1,
  "alternativeId": 1
}

###

# Avsluta och få resultatet.
POST {{VibeCheck.Api_HostAddress}}/api/quiz/attempts/{{attemptId}}/complete
Authorization: Bearer {{token}}

###

GET {{VibeCheck.Api_HostAddress}}/api/words
Accept: application/json



###

# Topplistan är publik. Ska fungera UTAN Authorization-header.
GET {{VibeCheck.Api_HostAddress}}/api/leaderboard
Accept: application/json

###

# Ogiltigt veckovärde ska ge 400, inte tyst falla tillbaka på "current".
GET {{VibeCheck.Api_HostAddress}}/api/leaderboard?week=forra
Accept: application/json

###

# Utan token ska rankat quiz ge 401.
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts

###

# Logga in och kopiera token ur svaret.
POST {{VibeCheck.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "user",
  "password": "User123!"
}

###

@rankedToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VS1Ao4IEGMd-u0QHmsVcBuXLAdx8XvW6NIIW4-99Oes

# Starta en omgång. Kolla i svaret: secondsRemaining 60, maxWrongAnswers 3,
# och 90 frågor i slumpad ordning. Kopiera rankedAttemptId nedan.
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts
Authorization: Bearer {{rankedToken}}

###

@rankedAttemptId = 5

# Avsluta DIREKT, utan att ha svarat och utan att tiden gått ut.
# Ska ge 400 "Omgången pågår fortfarande." – det är serverns tidskontroll.
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts/{{rankedAttemptId}}/complete
Authorization: Bearer {{rankedToken}}

###

# Svara på en fråga. Ta questionId och alternativeId ur startsvaret.
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts/{{rankedAttemptId}}/answers
Authorization: Bearer {{rankedToken}}
Content-Type: application/json

{
  "questionId": 1,
  "alternativeId": 1
}

###

# Samma fråga igen ska ge 400 "Frågan är redan besvarad."
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts/{{rankedAttemptId}}/answers
Authorization: Bearer {{rankedToken}}
Content-Type: application/json

{
  "questionId": 1,
  "alternativeId": 1
}

###

# Vänta tills 60 sekunder gått sedan starten, avsluta sedan.
# Nu ska det gå igenom med endReason "TimeUp".
POST {{VibeCheck.Api_HostAddress}}/api/ranked/attempts/{{rankedAttemptId}}/complete
Authorization: Bearer {{rankedToken}}

###

# Topplistan ska nu ha en rad. Med token får du även currentUserRow.
GET {{VibeCheck.Api_HostAddress}}/api/leaderboard
Authorization: Bearer {{rankedToken}}

###

# Föregående vecka ska vara tom.
GET {{VibeCheck.Api_HostAddress}}/api/leaderboard?week=previous